# Pulse-Eight USB-CEC adapter: attach the kernel pulse8-cec driver.
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", ATTRS{idVendor}=="2548", ATTRS{idProduct}=="1002", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hearth-pulse8-cec@%k.service"
# Let the person at the PC use CEC adapters (the Quick Menu's "Switch the TV
# to Hearth", and the TV privacy check reading the TV's make).
SUBSYSTEM=="cec", KERNEL=="cec[0-9]*", TAG+="uaccess"
