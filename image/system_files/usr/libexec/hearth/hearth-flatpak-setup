#!/usr/bin/bash
# Install Hearth's default apps and emulators from Flathub. Each app is
# attempted until it installs once; if you uninstall one later, it stays
# uninstalled.
set -uo pipefail
done_file=/var/lib/hearth/flatpaks-attempted
mkdir -p "$(dirname "$done_file")"
touch "$done_file"

flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# -h: with two lists grep would otherwise prefix each ID with "file:".
app_ids() { grep -hEv '^\s*(#|$)' "$@"; }

app_ids /usr/share/hearth/flatpaks.list /usr/share/hearth/emulators.list | while read -r app; do
    grep -qxF "$app" "$done_file" && continue
    echo "Installing $app"
    if flatpak install --system --noninteractive --or-update flathub "$app"; then
        echo "$app" >> "$done_file"
    else
        echo "Failed to install $app; will retry next boot" >&2
    fi
done

# Emulators need to read games and BIOS files outside their sandbox,
# including on other drives (Bazzite mounts those under /run/media or /var/mnt).
app_ids /usr/share/hearth/emulators.list | while read -r app; do
    flatpak override --system \
        --filesystem='~/ROMs' --filesystem='~/BIOS' \
        --filesystem=/run/media --filesystem=/var/mnt \
        "$app"
done

# Game launchers install games, so they need the other drives too.
for app in com.heroicgameslauncher.hgl net.lutris.Lutris; do
    flatpak info --system "$app" >/dev/null 2>&1 &&
        flatpak override --system --filesystem=/run/media --filesystem=/var/mnt "$app"
done
