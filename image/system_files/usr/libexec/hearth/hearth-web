#!/usr/bin/bash
# A streaming website as a full-screen TV app: hearth-web NAME URL
#
# Google Chrome (Flatpak), in kiosk mode: no tabs or address bar, the site
# fills the screen. Each NAME gets its own Chrome profile, so:
# - it's its own Chrome, and runs alongside another (e.g. one kept paused
#   for Quick Resume) instead of handing its URL to it and exiting;
# - you sign in to each service once, and stay signed in.
# The controller works as a mouse (Hearth's pointer mode); hold Guide to
# close it, like any app.
set -u
name=${1:?usage: hearth-web NAME URL}
url=${2:?usage: hearth-web NAME URL}
app=com.google.Chrome
profile=$HOME/.var/app/$app/hearth/$name
mkdir -p "$profile"

# X11: Hearth shows apps' windows through gamescope's X server.
exec flatpak run "$app" \
    --user-data-dir="$profile" \
    --kiosk --no-first-run --noerrdialogs --disable-session-crashed-bubble \
    --password-store=basic --ozone-platform=x11 \
    "$url"
