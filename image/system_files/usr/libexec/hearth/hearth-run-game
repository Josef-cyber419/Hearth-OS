#!/usr/bin/bash
# Start a PC game from ~/Games (an AppImage or a start script), from its own
# folder: ports of decompiled games often look for their data files next to
# themselves.
set -u
program=${1:?usage: hearth-run-game PROGRAM [ARGS...]}
shift
cd "$(dirname "$program")" || exit 1

# Hearth finds and shows an app's windows through gamescope's X server. SDL 3
# games (Dusklight...) prefer Wayland when they can reach it, and a Wayland
# window never appears: the game runs, you hear it, and the screen stays on
# Hearth's "starting" view. Ask SDL (2 and 3) for X11. Steam does the same
# for its games.
export SDL_VIDEODRIVER=x11 SDL_VIDEO_DRIVER=x11

# Downloads often lose the "executable" permission.
[[ -x $program ]] || chmod u+x "$program" 2>/dev/null

case ${program,,} in
*.appimage)
    # Without FUSE an AppImage can still run by unpacking itself first.
    if ! command -v fusermount >/dev/null && ! command -v fusermount3 >/dev/null; then
        export APPIMAGE_EXTRACT_AND_RUN=1
    fi
    exec "$program" "$@" ;;
*.sh)
    exec bash "$program" "$@" ;;
*)
    exec "$program" "$@" ;;
esac
