#!/usr/bin/bash
# Leave the TV session for the desktop (KDE Plasma or GNOME). Bazzite's
# "Return to Gaming Mode" shortcut on the desktop brings you back to Hearth.
# hearth-steam refuses a logout while Steam runs; make sure that's gone
# (e.g. if Steam was killed) so this deliberate switch goes through.
dropin=${XDG_RUNTIME_DIR:-/run/user/$UID}/systemd/user/graphical-session.target.d/50-hearth-steam.conf
if [[ -e $dropin ]]; then
    rm -f "$dropin"
    systemctl --user daemon-reload
fi

# A deliberate trip to the desktop: don't let it bounce back to Game Mode.
rm -f "${XDG_STATE_HOME:-$HOME/.local/state}/hearth/steam-in-hearth"

for select in /usr/libexec/os-session-select /usr/bin/steamos-session-select; do
    [[ -x $select ]] && exec "$select" plasma
done
if command -v steamosctl >/dev/null; then
    exec steamosctl switch-to-desktop-mode
fi
echo "hearth-desktop: no session switcher found; is this a Bazzite deck image?" >&2
exit 1
