#!/usr/bin/bash
# Steam in its console UI (the Steam Deck / Big Picture interface), running
# inside the current gamescope session. When Steam exits, Hearth comes back.
#
# Steam's "Switch to Desktop": with upstream SteamOS Manager it writes a
# one-time login session (Session=plasma...) to
# $sddm_dir/zzt-steamos-temp-login.conf and logs out. If that file appears
# while Steam runs here, it's cleared (hearth-session, through sudo), so the
# login that follows is Game Mode (Hearth) rather than the desktop, and Steam
# is asked to exit.
#
# Whatever path the switch takes, the desktop it lands on sends you back:
# while Steam runs, $marker is touched every half second, and the desktop's
# hearth-desktop-guide (desktopguide.py) switches straight back to Game Mode
# if it finds a fresh one when the desktop starts.
#
# An earlier version also refused the logout (RefuseManualStop on
# graphical-session.target) to keep the session up. Bazzite doesn't always go
# through that file, and then nothing brought you home: Steam hung on
# "Switching to Desktop". The logout is no longer blocked; the leftover
# drop-in (if any) is removed.

sddm_dir=${HEARTH_SDDM_DIR:-/etc/sddm.conf.d}
temp_login=$sddm_dir/zzt-steamos-temp-login.conf
dropin_dir=${XDG_RUNTIME_DIR:-/run/user/$UID}/systemd/user/graphical-session.target.d
dropin=$dropin_dir/50-hearth-steam.conf
marker=${XDG_STATE_HOME:-$HOME/.local/state}/hearth/steam-in-hearth

# Bazzite's Game Mode may run the "ogui-steam" session, which doesn't carry
# the stock Steam session's feature flags (HDR, VRR, tearing controls...).
# Load them if they're missing.
steam_session=/usr/share/gamescope-session-plus/sessions.d/steam
if [[ -z ${STEAM_GAMESCOPE_HDR_SUPPORTED:-} && -f $steam_session ]]; then
    # shellcheck source=/dev/null
    . "$steam_session"
fi

desktop_requested() {
    [[ -f $temp_login ]] && ! grep -qi '^Session=gamescope' "$temp_login"
}

clear_desktop_login() {
    sudo -n /usr/libexec/hearth/hearth-session clear-desktop-login ||
        echo "hearth-steam: couldn't clear $temp_login" >&2
}

cleanup() {
    rm -f "$dropin"
    systemctl --user daemon-reload 2>/dev/null
}

# Left over from before (e.g. Steam was killed mid-switch): not a new request.
desktop_requested && clear_desktop_login

# From an earlier version that blocked the logout; never leave it behind.
[[ -e $dropin ]] && cleanup
# Stopped from outside (the session is logging out): keep the marker. Steam
# closed by itself: remove it, so a later trip to the desktop isn't bounced.
ending=no
trap 'ending=yes; kill -TERM "$steam_pid" 2>/dev/null' TERM INT HUP
trap '[[ $ending == no ]] && rm -f "$marker"' EXIT
mkdir -p "$(dirname "$marker")"

# Started for one game (a game's tile: steam://rungameid/<id>): when that
# game has run and ended, close Steam too, so the TV comes back to Hearth.
# Otherwise it stays on Steam's own screens with no way home for a
# controller whose Guide button Steam keeps (field report #29).
appid=
for arg in "$@"; do
    [[ $arg =~ ^steam://rungameid/([0-9]+) ]] && appid=${BASH_REMATCH[1]}
done
game_running() {
    # Steam runs every game under its reaper: "reaper SteamLaunch AppId=<id> -- ..."
    pgrep -f "SteamLaunch AppId=$appid( |$)" >/dev/null 2>&1
}

steam -gamepadui -steamos3 -steampal -steamdeck "$@" &
steam_pid=$!

left=no
game_seen=no
gone=0
while kill -0 "$steam_pid" 2>/dev/null; do
    touch "$marker"
    if [[ $left == no ]] && desktop_requested; then
        echo "hearth-steam: Steam asked for the desktop; returning to Hearth instead" >&2
        clear_desktop_login
        steam -shutdown
        left=yes
    fi
    if [[ -n $appid && $left == no ]]; then
        if game_running; then
            game_seen=yes
            gone=0
        elif [[ $game_seen == yes ]] && (( ++gone >= 6 )); then  # 3 s: not just a relaunch
            echo "hearth-steam: game $appid ended; closing Steam and returning to Hearth" >&2
            steam -shutdown
            left=yes
        fi
    fi
    sleep 0.5
done
wait "$steam_pid"
