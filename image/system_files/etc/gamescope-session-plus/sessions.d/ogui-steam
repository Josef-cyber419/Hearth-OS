# Hearth: start the Hearth home screen instead of Steam in Game Mode.
# gamescope-session-plus sources this after the stock session config in
# /usr/share/gamescope-session-plus/sessions.d, so every Game Mode setting
# (HDR, VRR, resolution, env vars) is kept and only the client changes.
# Steam is launched from Hearth's Steam tile.
#
# To boot straight into Steam instead (no root needed): `hearthctl disable`.
# For one session only, the desktop's "Steam Gaming Mode" icon
# (hearth-gamemode --steam) leaves a steam-once file, used up here.
_hearth_cfg=${XDG_CONFIG_HOME:-$HOME/.config}/hearth
if [ -e "$_hearth_cfg/steam-once" ]; then
    rm -f "$_hearth_cfg/steam-once"
elif [ ! -e "$_hearth_cfg/disabled" ]; then
    export CLIENTCMD="/usr/bin/hearth"
fi
unset _hearth_cfg
